  "uiPatternConstraints": [
    {
      "pattern": "Modal",
      "allowed": false,
      "reason": "Modals disrupt workflow and are hard to dismiss on mobile. Use full-screen overlays or inline expansion instead.",
      "alternatives": ["Full-screen overlay", "Inline expansion", "Bottom sheet"]
    },
    {
      "pattern": "Hover state",
      "allowed": false,
      "reason": "Mobile devices do not support hover. Use press states and explicit tap targets.",
      "alternatives": ["Tap state", "Press and hold", "Explicit buttons"]
    },
    {
      "pattern": "Carousel",
      "allowed": false,
      "reason": "Carousels hide content and have poor discoverability. Use vertical lists or grids.",
      "alternatives": ["Vertical list", "Grid layout", "Tabbed sections"]
    },
    {
      "pattern": "Infinite scroll",
      "allowed": false,
      "reason": "Store associates need to know their progress. Use pagination or load more buttons.",
      "alternatives": ["Pagination", "Load more button", "Virtual list with count"]
    },
    {
      "pattern": "Bottom sheet",
      "allowed": true,
      "reason": "Bottom sheets are mobile-native and easy to dismiss."
    },
    {
      "pattern": "Pull to refresh",
      "allowed": true,
      "reason": "Familiar mobile pattern for refreshing lists."
    },
    {
      "pattern": "Swipe actions",
      "allowed": true,
      "reason": "Efficient for list item actions, but must have alternative explicit buttons."
    },
    {
      "pattern": "Floating action button",
      "allowed": true,
      "reason": "Good for primary actions, limited to one per screen."
    }
  ],

  "componentConstraints": [
    {
      "component": "Primary Button",
      "maxPerScreen": 1,
      "requiredContext": ["Clear action label", "Sufficient contrast"],
      "forbiddenWith": ["Another primary button"]
    },
    {
      "component": "Toast notification",
      "maxPerScreen": 1,
      "requiredContext": ["Dismissible", "Auto-dismiss after 3s for success"]
    },
    {
      "component": "Form input",
      "requiredContext": ["Label", "Error state", "Touch target minimum 44px"]
    }
  ],

