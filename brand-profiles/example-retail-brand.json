  "owner": "Brand & Design Team",

  "designPrinciples": [
    {
      "name": "Clarity First",
      "description": "Every screen should have a single, clear purpose. Users should understand what to do within 3 seconds.",
      "priority": "critical",
      "examples": [
        "One primary action per screen",
        "Clear visual hierarchy",
        "Descriptive button labels"
      ]
    },
    {
      "name": "Speed Over Polish",
      "description": "Store associates work fast. Minimize taps, optimize for one-handed use, and prioritize speed over visual flourishes.",
      "priority": "critical",
      "examples": [
        "Large touch targets",
        "Minimal multi-step flows",
        "Quick scan-and-go patterns"
      ]
    },
    {
      "name": "Error Prevention",
      "description": "Prevent errors rather than just reporting them. Use constraints, defaults, and confirmations for irreversible actions.",
      "priority": "high",
      "examples": [
        "Smart defaults based on context",
        "Inline validation",
        "Confirmation for destructive actions"
      ]
    },
    {
      "name": "Mobile-Native Experience",
      "description": "Design for mobile devices first. All interactions must work on a 5-inch screen held in one hand.",
      "priority": "critical"
    }
  ],

